.vscode/
.idea/
*.swp
*.swo
*~

# Local Environment Variables
.env
.env.local

# Documentation Planning Notes (Ignore internal notes, preserve images for README)
.md/*
!.md/*.jpg
!.md/*.png
!.md/*.jpeg
!.md/*.svg
!.md/*.webp

